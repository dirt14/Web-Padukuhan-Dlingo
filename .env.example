# Database Configuration
# For development, use SQLite (file:prisma/dev.db)
# For production, consider PostgreSQL or MySQL
DATABASE_URL="file:prisma/dev.db"

# NextAuth Configuration
# CRITICAL: Change this to a strong random string in production!
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-change-in-production-MUST-BE-SECURE"

# NextAuth URL
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# Optional: Email Configuration (for future features)
# EMAIL_SERVER="smtp://username:password@smtp.example.com:587"
# EMAIL_FROM="noreply@yourdomain.com"

# Optional: External API Keys (if needed)
# GOOGLE_MAPS_API_KEY=""
# GOOGLE_ANALYTICS_ID=""
