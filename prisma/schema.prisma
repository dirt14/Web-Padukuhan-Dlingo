generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          String    @default("KARANG_TARUNA") // ADMIN (Pak Dukuh) or KARANG_TARUNA
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  announcements Announcement[]
  activities    Activity[]
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  image       String?
  category    String   // BANTUAN_SOSIAL, KESEHATAN, KEGIATAN_DUSUN, UMUM
  priority    String   @default("NORMAL") // NORMAL, IMPORTANT
  showAsNotification Boolean @default(false)
  notificationStart DateTime?
  notificationEnd   DateTime?
  // Kurun waktu aktif pengumuman
  activeStart DateTime?  // Tanggal mulai tampil
  activeEnd   DateTime?  // Tanggal berakhir tampil
  status      String   @default("DRAFT") // DRAFT, PUBLISHED
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
}

model Activity {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  content     String?
  image       String?
  category    String   // BANK_SAMPAH, PENGAJIAN, KARANG_TARUNA, LAINNYA
  schedule    String?
  location    String?
  responsible String?
  status      String   @default("PUBLISHED") // DRAFT, PUBLISHED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  photos      Photo[]
}

model Photo {
  id          String   @id @default(cuid())
  url         String
  caption     String?
  category    String?
  albumId     String?
  album       Album?   @relation(fields: [albumId], references: [id])
  activityId  String?
  activity    Activity? @relation(fields: [activityId], references: [id])
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Album {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  photos      Photo[]
}

model VillageProfile {
  id          String   @id @default(cuid())
  vision      String
  mission     String
  history     String?
  address     String
  mapEmbed    String?
  mapLat      String?
  mapLng      String?
  phone       String?
  email       String?
  socialMedia String?  // JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrganizationMember {
  id          String   @id @default(cuid())
  name        String
  position    String
  image       String?
  phone       String?
  order       Int      @default(0)
  type        String   @default("VILLAGE") // VILLAGE or KARANG_TARUNA
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KarangTarunaProfile {
  id          String   @id @default(cuid())
  vision      String
  mission     String
  description String?
  workProgram String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id          String    @id @default(cuid())
  title       String
  message     String
  link        String?
  type        String    @default("INFO") // INFO, WARNING, URGENT
  active      Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SiteSettings {
  id          String   @id @default(cuid())
  logo        String?
  siteName    String   @default("Dusun Dlingo")
  tagline     String?
  heroImage   String?
  heroImage2  String?
  heroImage3  String?
  heroTitle   String?
  heroSubtitle String?
  footerText  String?

  // Feature toggles - Show/hide menu items
  showForum          Boolean @default(true)
  showDemographics   Boolean @default(true)
  showSuggestionBox  Boolean @default(true)
  showGallery        Boolean @default(true)
  showKegiatan       Boolean @default(true)
  showPengumuman     Boolean @default(true)
  showKarangTaruna   Boolean @default(true)
  showEdukasi        Boolean @default(true)

  // Static content editing
  aboutDusun         String?  // "Tentang Dusun Dlingo" section on homepage
  footerAbout        String?  // Footer about text
  footerQuickLinks   String?  // JSON array of footer links

  // Contact info
  phone              String?
  email              String?
  address            String?

  // Pak Dukuh contact
  dukuhName          String?
  dukuhPhone         String?
  dukuhEmail         String?

  // Karang Taruna contact
  karangTarunaName   String?
  karangTarunaPhone  String?

  // Secretariat address
  secretariatAddress String?
  secretariatMapUrl  String?

  // Social media
  facebook           String?
  instagram          String?
  twitter            String?
  youtube            String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Demografi & Statistik
model Demographics {
  id              String   @id @default(cuid())
  year            Int
  totalPopulation Int
  maleCount       Int
  femaleCount     Int
  ageData         String   // JSON: [{ageGroup: "0-5", count: 100}, ...]
  educationData   String   // JSON: [{level: "SD", count: 200}, ...]
  occupationData  String   // JSON: [{type: "Petani", count: 150}, ...]
  rtData          String?  // JSON: [{rt: "RT 22", households: 50, population: 150}, ...]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Forum/Diskusi
model ForumCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  topics      ForumTopic[]
}

model ForumTopic {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  content     String
  categoryId  String
  category    ForumCategory @relation(fields: [categoryId], references: [id])
  authorName  String
  authorEmail String?
  views       Int           @default(0)
  isPinned    Boolean       @default(false)
  isLocked    Boolean       @default(false)
  status      String        @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  replies     ForumReply[]
}

model ForumReply {
  id          String     @id @default(cuid())
  content     String
  topicId     String
  topic       ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String?
  status      String     @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Kotak Saran
model Suggestion {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  category    String   // INFRASTRUKTUR, PELAYANAN, KEGIATAN, LAINNYA
  subject     String
  message     String
  status      String   @default("PENDING") // PENDING, REVIEWED, RESPONDED
  response    String?
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// FAQ
model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String   // ADMINISTRASI, PELAYANAN, KEGIATAN, UMUM
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Portal Edukasi & Artikel
model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  image       String?
  category    String   // KESEHATAN, PERTANIAN, KEWIRAUSAHAAN, PENDIDIKAN, LAINNYA
  tags        String?  // JSON array
  views       Int      @default(0)
  status      String   @default("DRAFT") // DRAFT, PUBLISHED
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    ArticleComment[]
}

// Komentar Artikel
model ArticleComment {
  id          String   @id @default(cuid())
  content     String
  authorName  String
  authorEmail String?
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      ArticleComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ArticleComment[] @relation("CommentReplies")
  status      String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Perpustakaan Digital
model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileSize    Int?     // in bytes
  fileType    String?  // pdf, doc, xls, etc
  category    String   // PERATURAN, SURAT_KETERANGAN, FORMULIR, PANDUAN, LAINNYA
  downloads   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
